---
const { useTracking, apiKey } = Astro.props;
---
<>
  <meta name="posthog-use-tracking" content={useTracking ? "true" : "false"} />
</>
{useTracking && (
<script is:inline define:vars={{ apiKey }}>
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    // Three cases, decided once per page load from our own consent record:
    //  - accepted cookies: normal PostHog persistence.
    //  - signed in without accepting: state in memory only, and identify.js
    //    links events to the account ID on every page.
    //  - everyone else (undecided or declined): PostHog cookieless mode. No
    //    cookies or storage; PostHog's servers derive a daily-rotating hash for
    //    the person and assign $session_id. Without this, each page load was a
    //    new person and a new session for most visitors. Needs "Cookieless
    //    server hash mode" on in the project settings or these events are dropped.
    // Accepting on the banner takes effect from the next page load.
    var phConsent = null;
    var phSignedIn = false;
    try {
        phConsent = localStorage.getItem('cookie_consent');
        // supabase-js keeps its session under sb-<project-ref>-auth-token.
        for (var i = 0; i < localStorage.length; i++) {
            if (/^sb-.+-auth-token$/.test(localStorage.key(i) || '')) phSignedIn = true;
        }
    } catch (e) {}

    var phPrivacy = phConsent === 'yes'
        ? { persistence: 'localStorage+cookie' }
        : phSignedIn
            ? { persistence: 'memory' }
            : { cookieless_mode: 'always' };

    posthog.init(
        apiKey,
        Object.assign({
            api_host:'https://b.sim8085.com',
            ui_host:'https://us.posthog.com',
            // Sim8085 is click-heavy by nature (Step, editor clicks, register/memory
            // edits), so autocapture produced ~24 events per pageview. We rely on the
            // explicit trackEvent() calls instead.
            autocapture: false,
            capture_heatmaps: false,
            capture_dead_clicks: false,
            // Rapidly clicking Step to walk through a program trips the rageclick
            // heuristic, so this was noise rather than signal.
            rageclick: false,
            capture_performance: false,
        }, phPrivacy)
    )
</script>
)}
